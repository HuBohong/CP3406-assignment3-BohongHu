    <!-- Story -->
    <string name="story_title">Byte needs your help</string>
    <string name="story_body">Byte\'s ship has crash-landed at the edge of the Kotlin galaxy. Every system on board runs on code, and every lesson you finish repairs one of them.</string>
    <string name="story_goal">Fix the ship, fly from planet to planet, and then use what you have learned to build worlds of your own.</string>
    <string name="story_next">Help Byte</string>
    <string name="story_log_title">Ship\'s log</string>
    <string name="story_beat_basics_1">Fuel tank sealed. Byte can store values again, so the engines finally have something to burn.</string>
    <string name="story_beat_basics_2">The radio crackles to life. First message home: \"Hi, still in one piece!\"</string>
    <string name="story_beat_flow_1">Shields can make decisions now. If an asteroid comes close, they go up on their own.</string>
    <string name="story_beat_flow_2">Launch sequence repaired. Byte counts down, and the thrusters fire on zero.</string>
    <string name="story_beat_fun_1">Boosters wrapped in functions. Byte writes a boost once and calls it whenever it likes.</string>
    <string name="story_beat_fun_2">Autopilot online. Byte hands it little lambdas that say what to do at each planet.</string>
    <string name="story_beat_data_1">Star charts restored. Every planet and its distance is back in one tidy list.</string>
    <string name="story_beat_data_2">Sensors no longer crash on empty space. All systems online: Byte can fly anywhere. Try building your own planet!</string>

    <!-- Onboarding -->
    <string name="onboarding_title">Before we launch</string>
    <string name="onboarding_intro">Learn Kotlin in short lessons: read code, predict what it prints and put programs back in order.</string>
    <string name="onboarding_promise_title">How CodeQuest treats you</string>
    <string name="onboarding_promise_offline">Every core lesson works offline.</string>
    <string name="onboarding_promise_no_account">No account. Your progress stays on this device and is not backed up to the cloud.</string>
    <string name="onboarding_promise_no_ads">No ads, no tracking and no location or photo-library access.</string>
    <string name="onboarding_promise_no_pressure">No streaks to lose and no reminders. Learn when it suits you.</string>
    <string name="onboarding_question_title">Save a detailed answer history?</string>
    <string name="onboarding_question_body">If you say yes, CodeQuest records each answer (question, topic, right or wrong) on this device so the Progress tab can show your accuracy by topic. Nothing is sent anywhere.</string>
    <string name="onboarding_decline">No, don\'t save it</string>
    <string name="onboarding_accept">Yes, save it</string>
    <string name="onboarding_footnote">Either way you get every lesson. You can change this at any time in Settings, and switching it off deletes the saved history.</string>

