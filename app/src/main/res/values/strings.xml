    <!-- Onboarding -->
    <string name="onboarding_title">Welcome to CodeQuest</string>
    <string name="onboarding_intro">Learn Kotlin in short lessons: read code, predict what it prints and put programs back in order.</string>
    <string name="onboarding_promise_title">How CodeQuest treats you</string>
    <string name="onboarding_promise_offline">• Every core lesson works offline.</string>
    <string name="onboarding_promise_no_account">• No account. Your progress stays on this device and is not backed up to the cloud.</string>
    <string name="onboarding_promise_no_ads">• No ads, no tracking and no location or photo-library access.</string>
    <string name="onboarding_promise_no_pressure">• No streaks to lose and no reminders. Learn when it suits you.</string>
    <string name="onboarding_question_title">Save a detailed answer history?</string>
    <string name="onboarding_question_body">If you say yes, CodeQuest records each answer (question, topic, right or wrong) on this device so the Progress tab can show your accuracy by topic. Nothing is sent anywhere.</string>
    <string name="onboarding_decline">No, don\'t save it</string>
    <string name="onboarding_accept">Yes, save it</string>
    <string name="onboarding_footnote">Either way you get every lesson. You can change this at any time in Settings, and switching it off deletes the saved history.</string>

